{
  "name": "wlsaplus",
  "productName": "WLSAPlus",
  "version": "1.0.2",
  "private": true,
  "description": "A local-first schedule and task app for WLSA students",
  "author": "WLSAPlus contributors",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:web": "ng build --configuration production",
    "test": "ng test --watch=false && node --test electron/*.test.cjs scripts/*.test.mjs",
    "version:apply": "node scripts/set-build-version.mjs",
    "updates:cache-key": "node scripts/add-update-cache-key.mjs out-builder/latest.yml",
    "record:powerschool": "node scripts/record-powerschool.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "vpn:core": "node scripts/download-vpn-core.mjs",
    "electron:dev": "npm run vpn:core && concurrently -k \"ng serve\" \"wait-on http://localhost:4200 && cross-env WLSAPLUS_DEV_URL=http://localhost:4200 electron .\"",
    "electron:start": "npm run vpn:core && npm run build:web && electron .",
    "electron:make": "npm run vpn:core && npm run build:web && electron-forge make",
    "electron:make:windows": "npm run vpn:core && npm run build:web && electron-builder --win nsis --x64 --publish never",
    "capacitor:sync": "npm run build:web && node scripts/prepare-android-build.mjs && cap sync android",
    "android:open": "npm run capacitor:sync && cap open android",
    "android:build": "npm run capacitor:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@angular/cdk": "^22.1.4",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/material": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/router": "^22.1.4",
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@fontsource/roboto": "^5.3.0",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "material-symbols": "^0.47.0",
    "electron-updater": "^6.8.9",
    "rxjs": "~7.8.2",
    "tesseract.js": "^7.0.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "@capacitor/cli": "^8.5.0",
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron/universal": "^3.0.6",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "extract-zip": "^2.0.1",
    "js-yaml": "^4.3.2",
    "jsdom": "^28.0.0",
    "playwright": "^1.55.0",
    "png2icons": "^2.0.1",
    "sharp": "^0.35.4",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11",
    "wait-on": "^9.0.1"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "config": {
    "forge": "./forge.config.cjs"
  }
}
